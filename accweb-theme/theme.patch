+// ACCDCServer race control theme for accweb.
+// Same class names as upstream accweb, only the look changes.
+
+$bg: #0a0c10;
+$panel: #12161d;
+$panel-2: #181d26;
+$line: #262d39;
+$line-strong: #343d4d;
+$text: #e6e9ef;
+$muted: #8b95a7;
+$accent: #e10600;
+$accent-2: #ff5a1f;
+$green: #22c55e;
+$green-dark: #0f3d22;
+$red: #f04438;
+$red-dark: #3d1214;
+$amber: #f5b301;
+
+$font_size: 14px;
+$font_size_small: 12px;
+$font_family: "Titillium Web", "Segoe UI", Roboto, sans-serif;
+$mono: "JetBrains Mono", Consolas, "Courier New", monospace;
+$radius: 10px;
+
+html,
+body {
+	min-height: 100%;
+	margin: 0;
+	padding: 0;
+	font-size: $font_size;
+	font-family: $font_family;
+	color: $text;
+	line-height: 1.35;
+	background-color: $bg;
+}
+
+body {
+	min-height: 100vh;
+	display: flow-root;
+	overflow-x: hidden;
+	background-image:
+		radial-gradient(ellipse 80% 40% at 50% -10%, rgba($accent, 0.22), transparent 70%),
+		repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.018) 0 2px, transparent 2px 6px);
+	background-attachment: fixed;
+}
+
+html {
+	margin-right: calc(-100vw + 100%);
+	/* Fix for scroll-bar jump */
+}
+
+* {
+	scrollbar-color: $line-strong $bg;
+}
+
+// Header with brand and checkered strip
+.topbar {
+	position: relative;
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	margin: -24px -24px 24px -24px;
+	padding: 18px 24px 16px 24px;
+	border-bottom: 1px solid $line;
+	background: linear-gradient(90deg, rgba($accent, 0.14), transparent 60%);
+	border-radius: $radius $radius 0 0;
+
+	&::before {
+		content: "";
+		position: absolute;
+		left: 0;
+		right: 0;
+		top: 0;
+		height: 6px;
+		border-radius: $radius $radius 0 0;
+		background:
+			conic-gradient(#fff 25%, #111 0 50%, #fff 0 75%, #111 0) 0 0 / 12px 12px;
+		opacity: 0.85;
+	}
+}
+
+.brand {
+	display: flex;
+	align-items: center;
+	gap: 12px;
+	color: $text;
+
+	.brand-mark {
+		display: inline-flex;
+		align-items: center;
+		justify-content: center;
+		padding: 4px 12px;
+		font-weight: 900;
+		font-style: italic;
+		font-size: 20px;
+		letter-spacing: 1px;
+		color: #fff;
+		background: linear-gradient(135deg, $accent, $accent-2);
+		transform: skewX(-12deg);
+		border-radius: 4px;
+		box-shadow: 0 6px 18px rgba($accent, 0.35);
+
+		span {
+			transform: skewX(12deg);
+		}
+	}
+
+	.brand-text {
+		display: flex;
+		flex-direction: column;
+		line-height: 1.1;
+
+		strong {
+			font-size: 17px;
+			font-weight: 700;
+			letter-spacing: 0.5px;
+			text-transform: uppercase;
+		}
+
+		small {
+			font-size: 11px;
+			color: $muted;
+			letter-spacing: 2px;
+			text-transform: uppercase;
+		}
+	}
+}
+
+.main {
+	max-width: 1000px;
+	margin: 40px auto;
+	padding: 24px;
+	background: rgba($panel, 0.92);
+	border: 1px solid $line;
+	border-radius: $radius;
+	box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
+	backdrop-filter: blur(6px);
+
+	.title {
+		display: flex;
+		flex-wrap: wrap;
+		gap: 10px;
+		justify-content: space-between;
+		align-items: center;
+		margin: 0 0 20px 0;
+
+		.menu {
+			display: flex;
+			flex-wrap: wrap;
+			gap: 6px;
+			justify-content: flex-end;
+			align-items: center;
+
+			button,
+			select {
+				margin: 0;
+			}
+		}
+	}
+
+	// Server card on the overview
+	.server {
+		position: relative;
+		display: flex;
+		gap: 16px;
+		justify-content: space-between;
+		align-items: center;
+		margin: 12px 0;
+		padding: 18px 18px 18px 22px;
+		background: linear-gradient(180deg, $panel-2, $panel);
+		border: 1px solid $line;
+		border-radius: $radius;
+		overflow: hidden;
+		transition: border-color 0.2s, transform 0.2s;
+
+		&::before {
+			content: "";
+			position: absolute;
+			left: 0;
+			top: 0;
+			bottom: 0;
+			width: 4px;
+			background: $line-strong;
+		}
+
+		&.is-online::before {
+			background: $green;
+			box-shadow: 0 0 16px $green;
+		}
+
+		&:hover {
+			border-color: $line-strong;
+			transform: translateY(-1px);
+		}
+
+		.name {
+			display: flex;
+			flex-wrap: wrap;
+			align-items: center;
+			gap: 10px;
+			font-size: 18px;
+			font-weight: 700;
+			margin: 0 0 10px 0;
+
+			.fas {
+				margin: 0 4px;
+				cursor: pointer;
+				color: $muted;
+				transition: color 0.15s;
+
+				&:hover {
+					color: $text;
+				}
+			}
+		}
+
+		.info {
+			color: $muted;
+			font-size: 13px;
+
+			b {
+				color: $text;
+				font-weight: 600;
+			}
+		}
+
+		.chips {
+			display: flex;
+			flex-wrap: wrap;
+			gap: 6px;
+			margin: 0 0 6px 0;
+		}
+
+		.chip {
+			display: inline-flex;
+			align-items: center;
+			gap: 6px;
+			padding: 3px 9px;
+			font-size: 12px;
+			color: $muted;
+			background: rgba(255, 255, 255, 0.04);
+			border: 1px solid $line;
+			border-radius: 999px;
+
+			b {
+				color: $text;
+				font-weight: 600;
+			}
+
+			.fas {
+				margin: 0;
+				font-size: 11px;
+				cursor: default;
+			}
+		}
+
+		.server-buttons {
+			display: flex;
+			flex-direction: column;
+			gap: 6px;
+			min-width: 120px;
+
+			button {
+				margin: 0;
+				justify-content: center;
+			}
+		}
+
+		.start {
+			background: $green-dark;
+			color: $green;
+			border-color: rgba($green, 0.35);
+		}
+
+		.stop {
+			background: $red-dark;
+			color: $red;
+			border-color: rgba($red, 0.35);
+		}
+
+		.restart {
+			background: rgba($amber, 0.1);
+			color: $amber;
+			border-color: rgba($amber, 0.35);
+		}
+
+		.online,
+		.offline {
+			display: flex;
+			justify-content: center;
+			align-items: center;
+			padding: 6px 12px;
+			border-radius: 999px;
+			font-weight: 600;
+		}
+
+		.online {
+			background: $green-dark;
+			color: $green;
+		}
+
+		.offline {
+			background: $red-dark;
+			color: $red;
+		}
+	}
+}
+
+// Status pill with pulsing dot
+.status-pill {
+	display: inline-flex;
+	align-items: center;
+	gap: 7px;
+	padding: 3px 10px;
+	font-size: 11px;
+	font-weight: 700;
+	letter-spacing: 1px;
+	text-transform: uppercase;
+	border-radius: 999px;
+	color: $muted;
+	background: rgba(255, 255, 255, 0.05);
+	border: 1px solid $line;
+
+	.dot {
+		width: 8px;
+		height: 8px;
+		border-radius: 50%;
+		background: $muted;
+	}
+
+	&.online {
+		color: $green;
+		background: rgba($green, 0.1);
+		border-color: rgba($green, 0.35);
+
+		.dot {
+			background: $green;
+			animation: pulse 1.6s infinite;
+		}
+	}
+}
+
+@keyframes pulse {
+	0% {
+		box-shadow: 0 0 0 0 rgba($green, 0.7);
+	}
+
+	70% {
+		box-shadow: 0 0 0 8px rgba($green, 0);
+	}
+
+	100% {
+		box-shadow: 0 0 0 0 rgba($green, 0);
+	}
+}
+
+.main-small {
+	max-width: 440px;
+	margin-top: 12vh;
+}
+
+.end {
+	font-size: $font_size_small;
+	text-align: center;
+	margin: 28px 0 0 0;
+	opacity: 0.6;
+
+	a {
+		color: $muted;
+	}
+}
+
+.tabs {
+	display: flex;
+	gap: 4px;
+	margin: 0 0 20px 0;
+	border-bottom: 1px solid $line;
+
+	.tab {
+		padding: 10px 14px;
+		color: $muted;
+		font-weight: 600;
+		border-bottom: 2px solid transparent;
+		margin-bottom: -1px;
+		cursor: pointer;
+		transition: color 0.15s;
+
+		&:hover {
+			color: $text;
+		}
+	}
+
+	.tab-active {
+		color: $text;
+		border-bottom-color: $accent;
+	}
+}
+
+.collapsible {
+	margin: 10px 0;
+	background: $panel-2;
+	border: 1px solid $line;
+	border-radius: $radius;
+
+	.collapsible-title {
+		display: flex;
+		justify-content: space-between;
+		align-items: center;
+		padding: 13px 16px;
+		font-weight: 700;
+		letter-spacing: 0.3px;
+		cursor: pointer;
+		user-select: none;
+
+		&:hover {
+			color: #fff;
+		}
+
+		.collapse-icon {
+			cursor: pointer;
+			color: $muted;
+		}
+	}
+
+	.collapsible-content {
+		padding: 16px;
+		border-top: 1px solid $line;
+	}
+}
+
+.box {
+	background: $panel-2;
+	border: 1px solid $line;
+	border-radius: $radius;
+	padding: 20px;
+	margin: 10px 0;
+
+	&.condensed {
+		padding: 6px 20px;
+	}
+}
+
+.error-toast,
+.success-toast {
+	position: fixed;
+	left: 50%;
+	top: 20px;
+	z-index: 100;
+
+	.error-content,
+	.success-content {
+		position: relative;
+		left: -50%;
+		border-radius: 8px;
+		padding: 12px 16px;
+		font-weight: 600;
+		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
+	}
+
+	.error-content {
+		background: $red;
+		color: #fff;
+	}
+
+	.success-content {
+		background: $green;
+		color: #04140a;
+	}
+}
+
+h1 {
+	display: flex;
+	align-items: center;
+	min-height: 40px;
+	font-size: 24px;
+	font-weight: 700;
+	letter-spacing: 0.3px;
+	margin: 0;
+}
+
+button,
+input[type~="submit"] {
+	display: inline-flex;
+	align-items: center;
+	gap: 7px;
+	width: auto;
+	font-size: 13px;
+	font-weight: 600;
+	font-family: $font_family;
+	letter-spacing: 0.3px;
+	background: $panel-2;
+	color: $text;
+	border: 1px solid $line-strong;
+	border-radius: 7px;
+	padding: 8px 14px;
+	margin: 4px 0;
+	cursor: pointer;
+	transition: filter 0.15s, border-color 0.15s, transform 0.05s;
+
+	&:hover {
+		filter: brightness(1.18);
+		border-color: $muted;
+	}
+
+	&:active {
+		transform: translateY(1px);
+	}
+
+	.fas {
+		margin: 0;
+	}
+}
+
+input,
+select,
+textarea {
+	width: 100%;
+	box-sizing: border-box;
+	font-size: $font_size;
+	font-family: $font_family;
+	background: $bg;
+	color: $text;
+	border: 1px solid $line-strong;
+	border-radius: 7px;
+	padding: 8px 10px;
+	margin: 5px 0;
+	transition: border-color 0.15s, box-shadow 0.15s;
+
+	&:focus {
+		outline: none;
+		border-color: $accent-2;
+		box-shadow: 0 0 0 3px rgba($accent, 0.25);
+	}
+}
+
+textarea,
+pre {
+	font-family: $mono;
+	font-size: 12px;
+}
+
+input[type~="checkbox"] {
+	width: 16px;
+	height: 16px;
+	margin: 0 8px 0 0;
+	accent-color: $accent;
+	box-shadow: none;
+}
+
+input[disabled="disabled"],
+input:disabled {
+	opacity: 0.55;
+}
+
+.checkbox {
+	display: flex;
+	align-items: center;
+	height: 30px;
+
+	label {
+		display: flex;
+		align-items: center;
+		font-size: $font_size;
+	}
+}
+
+select {
+	width: auto;
+	display: block;
+}
+
+label {
+	display: block;
+	width: 100%;
+	box-sizing: border-box;
+	font-size: $font_size_small;
+	font-weight: 600;
+	color: $muted;
+	letter-spacing: 0.3px;
+}
+
+.primary {
+	background: linear-gradient(135deg, $accent, $accent-2) !important;
+	color: #fff !important;
+	border-color: transparent !important;
+	box-shadow: 0 6px 18px rgba($accent, 0.3);
+}
+
+.danger {
+	background: $red-dark !important;
+	color: $red !important;
+	border-color: rgba($red, 0.35) !important;
+}
+
+.disabled {
+	opacity: 0.5;
+	pointer-events: none;
+}
+
+.error {
+	color: $red;
+	width: 100%;
+	box-sizing: border-box;
+	font-size: $font_size_small;
+}
+
+a {
+	color: $accent-2;
+	text-decoration: none;
+}
+
+.button-row {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 8px;
+}
+
+.button-row>button {
+	margin-right: 0;
+}
+
+.server-settings-container {
+	display: grid;
+	grid-gap: 1.2rem 1.6rem;
+	margin-bottom: 1rem;
+}
+
+.server-settings-group {
+	margin: 1rem 0;
+}
+
+.server-settings-container.two-columns {
+	grid-template-columns: 1fr 1fr;
+}
+
+.server-settings-container.three-columns {
+	grid-template-columns: 1fr 1fr 1fr;
+}
+
+.server-settings-container.four-columns {
+	grid-template-columns: 1fr 1fr 1fr 1fr;
+}
+
+.server-settings-container.one-two-columns {
+	grid-template-columns: 1fr 2fr;
+}
+
+.server-settings-container.one-three-columns {
+	grid-template-columns: 1fr 3fr;
+}
+
+table {
+	border-collapse: collapse;
+
+	th {
+		text-align: left;
+		color: $muted;
+		font-size: 12px;
+		text-transform: uppercase;
+		letter-spacing: 1px;
+		padding: 8px;
+		border-bottom: 1px solid $line-strong;
+	}
+
+	td {
+		padding: 8px;
+		border-bottom: 1px solid $line;
+	}
+}
+
+.sort {
+	display: flex;
+	justify-content: flex-end;
+
+	label {
+		display: flex;
+		align-items: center;
+		gap: 8px;
+		width: auto;
+	}
+}
+
+@media (max-width: 700px) {
+	.main {
+		margin: 0;
+		border-radius: 0;
+		padding: 16px;
+	}
+
+	.topbar {
+		margin: -16px -16px 20px -16px;
+		border-radius: 0;
+
+		&::before {
+			border-radius: 0;
+		}
+	}
+
+	.main .server {
+		flex-direction: column;
+		align-items: stretch;
+
+		.server-buttons {
+			flex-direction: row;
+
+			button {
+				flex: 1;
+			}
+		}
+	}
+
+	.server-settings-container.two-columns,
+	.server-settings-container.three-columns,
+	.server-settings-container.four-columns,
+	.server-settings-container.one-two-columns,
+	.server-settings-container.one-three-columns {
+		grid-template-columns: 1fr;
+	}
+}
