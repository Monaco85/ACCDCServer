+import axios from "axios";
+
+// Waits until accweb reports the instance as stopped. Stop only kills the
+// process, the "running" flag clears a moment later.
+export function waitStopped(id, tries = 30) {
+    return new Promise((resolve, reject) => {
+        const check = (left) => {
+            axios.get(`/api/instance/${id}`)
+                .then(r => {
+                    if (!r.data.is_running) {
+                        resolve();
+                    } else if (left <= 0) {
+                        reject(new Error("server did not stop in time"));
+                    } else {
+                        setTimeout(() => check(left - 1), 500);
+                    }
+                })
+                .catch(reject);
+        };
+        check(tries);
+    });
+}
+
+export function stopAndWait(id) {
+    return axios.post(`/api/instance/${id}/stop`).then(() => waitStopped(id));
+}
+
+export function restartServer(id) {
+    return stopAndWait(id).then(() => axios.post(`/api/instance/${id}/start`));
+}
+
+export function errorText(e) {
+    return (e && e.response && e.response.data && e.response.data.error) || (e && e.message) || "";
+}
